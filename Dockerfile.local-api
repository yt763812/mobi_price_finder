
# Use prebuilt Telegram Bot API from GitHub Container Registry
FROM ghcr.io/yt763812/mobi-telegram-api-base:stable

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

RUN chmod +x run_local_bot_api.sh start_with_local_api.sh \
    && mkdir -p /data/bot-api

ENV TELEGRAM_LOCAL_API_URL=http://127.0.0.1:8081
ENV TELEGRAM_API_FILES_ROOT=/data/bot-api

CMD ["/bin/sh", "./start_with_local_api.sh"]
